# Copy to keystore.properties (git-ignored) to get a signed release APK from scripts/build-apk.*.
# Create a keystore once with:
#   keytool -genkeypair -v -keystore mono-hermes-release.jks -alias mono-hermes -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks and this file OUT of the repository. CI uses the ANDROID_KEYSTORE_* secrets instead
# (see .github/workflows/release.yml).
storeFile=/path/to/mono-hermes-release.jks
storePassword=change-me
keyAlias=mono-hermes
keyPassword=change-me
